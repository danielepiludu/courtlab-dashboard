{
  "name": "courtlab",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "description": "Courtlab — minuti giocati, carico di fatica (INT) e prestazione dei giocatori, multi-squadra",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make-icons.py && node scripts/make-app-icons.cjs && node scripts/make-og.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^5.8.8",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
